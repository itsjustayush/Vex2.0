rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function createsOwner(userId) {
      return signedIn() && request.resource.data.user_id == userId;
    }

    function preservesOwner(userId) {
      return signedIn()
        && resource.data.user_id == userId
        && request.resource.data.user_id == userId;
    }

    // Vex's primary schema. Every user's data is isolated under their auth UID.
    match /users/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;

      match /pages/{pageId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      match /boards/{boardId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId);

        match /items/{itemId} {
          allow read, create, update: if isOwner(userId);
          allow delete: if isOwner(userId);
        }
      }

      match /settings/{settingId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }

    // OTP challenge records are server-only. The Flask backend uses Firebase Admin credentials.
    match /otp_challenges/{challengeId} {
      allow read, write: if false;
    }

    // Legacy collections remain available only to the owning authenticated user.
    match /projects/{projectId} {
      allow read: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if createsOwner(request.auth.uid);
      allow update: if preservesOwner(request.auth.uid);
      allow delete: if signedIn() && resource.data.user_id == request.auth.uid;
    }

    match /files/{fileId} {
      allow read: if resource.data.is_public == true
        || (signedIn() && resource.data.user_id == request.auth.uid);
      allow create: if createsOwner(request.auth.uid);
      allow update: if preservesOwner(request.auth.uid);
      allow delete: if signedIn() && resource.data.user_id == request.auth.uid;
    }

    match /api_keys/{keyId} {
      allow read: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if createsOwner(request.auth.uid);
      allow update: if preservesOwner(request.auth.uid);
      allow delete: if signedIn() && resource.data.user_id == request.auth.uid;
    }
  }
}
