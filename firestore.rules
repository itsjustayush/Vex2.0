rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Authenticated user subtree access
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /boards/{boardId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        match /items/{itemId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      match /pages/{pageId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /settings/{settingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /typing/{typingDoc} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Catch-all for any other subcollections in the user's tree
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /otp_challenges/{challengeId} {
      allow read, write: if false;
    }
  }
}



