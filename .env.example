BOT_NAME=Vex
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MAX_HISTORY_MESSAGES=20
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIRESTORE_DATABASE_ID=
FIREBASE_SERVICE_ACCOUNT_KEY=

# Public deployment origin used by canonical, robots, sitemap, and OTP links.
VEX_SITE_URL=https://your-vex-domain.example

# Resend transactional email. Never commit the real value.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=Vex <auth@your-verified-domain.example>

# HMAC secret used to hash OTP codes at rest. Use a long random value.
OTP_SECRET=replace-with-a-long-random-secret
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
